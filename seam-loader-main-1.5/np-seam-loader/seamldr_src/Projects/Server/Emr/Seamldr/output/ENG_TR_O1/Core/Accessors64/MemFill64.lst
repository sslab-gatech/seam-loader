   902                              <1> ;  Implementation of MULTIPUSH and MULTIPOP Macro
   903                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   904                              <1> 
   905                              <1> 
   906                              <1> %macro  MULTIPUSH 1-*
   907                              <1> 
   908                              <1>   %rep  %0
   909                              <1>         push    %1
   910                              <1>   %rotate 1
   911                              <1>   %endrep
   912                              <1> 
   913                              <1> %endmacro
   914                              <1> 
   915                              <1> %macro  MULTIPOP 1-*
   916                              <1> 
   917                              <1>   %rep %0
   918                              <1>   %rotate -1
   919                              <1>         pop     %1
   920                              <1>   %endrep
   921                              <1> 
   922                              <1> %endmacro
   923                              <1> 
   924                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   925                              <1> ;  Implementation of PROLOGUE and EPILOGUE  Macro
   926                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   927                              <1> %macro  PROLOGUE 1
   928                              <1>         push    ebp
   929                              <1>         mov     ebp,esp
   930                              <1>         sub     esp,%1
   931                              <1> %endmacro
   932                              <1> 
   933                              <1> %macro  PROLOGUE 0
   934                              <1>         push    ebp
   935                              <1>         mov     ebp,esp
   936                              <1> %endmacro
   937                              <1> 
   938                              <1> %macro  EPILOGUE  0
   939                              <1>         leave
   940                              <1>         ret
   941                              <1> %endmacro
   942                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   943                              <1> ;  Implementation of DEBUG_BREAK_POINT Macro define DEBUG before using
   944                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   945                              <1> 
   946                              <1> %ifdef DEBUG
   947                              <1> 
   948                              <1> %macro DEBUG_BREAK_POINT 0
   949                              <1>         jmp     $
   950                              <1> %endmacro
   951                              <1> 
   952                              <1> %macro PRINT_TO_PORT 1
   953                              <1>         push ax
   954                              <1>         mov ax, %1
   955                              <1>         out PORT80, ax
   956                              <1>         pop ax
   957                              <1> %endmacro
   958                              <1> 
   959                              <1> %else
   960                              <1> %macro DEBUG_BREAK_POINT  0
   961                              <1> %endmacro
   962                              <1> 
   963                              <1> %macro PRINT_TO_PORT 1
   964                              <1> %endmacro
   965                              <1> 
   966                              <1> %endif

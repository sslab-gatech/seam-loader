   968                              <1> %endif
    26                                  
    27                                  
    28                                  segment .data  align=16
    28                              <1>  ;;; [macro] segment {.data align=16}
     0                              <1> %define __?SECT?__ [segment %1]
     0                              <1>  ;;; %define __?SECT?__ [segment .data align=16]
     0                              <1> __?SECT?__
     0                              <1>  ;;; [segment .data align=16]
    29                                      movdir64b_supported    db 0xff    ; 0xff = uninitialized, 0 = not supported, 1 = supported
    29 00000000 FF                       ;;;  movdir64b_supported db 0xff
    30                                  
    31                                  segment .text  align=16
    31                              <1>  ;;; [macro] segment {.text align=16}
     0                              <1> %define __?SECT?__ [segment %1]
     0                              <1>  ;;; %define __?SECT?__ [segment .text align=16]
     0                              <1> __?SECT?__
     0                              <1>  ;;; [segment .text align=16]
    32                                  
    33                                  ;-----------------------------------------------------------------------------
    34                                  ;-----------------------------------------------------------------------------
    35                                  ;  Procedure:	check_movdir64b_support
    36                                  ; 
    37                                  ;  Input:	None
    38                                  ; 
    39                                  ;  Output:	AL = 1 if MOVDIR64B is supported, 0 if not
    40                                  ; 
    41                                  ;  Description:  Check if MOVDIR64B instruction is supported using CPUID
    42                                  ;                MOVDIR64B is indicated by bit 28 in ECX when CPUID(EAX=7, ECX=0)
    43                                  ; 
    44                                  ;-----------------------------------------------------------------------------
    45                                  ;-----------------------------------------------------------------------------
    46                                  check_movdir64b_support:
    46                                   ;;; check_movdir64b_support:
    47                                      push       rbx
    47 00000000 53                       ;;;  push rbx
    48                                      push       rcx
    48 00000001 51                       ;;;  push rcx
    49                                      push       rdx
    49 00000002 52                       ;;;  push rdx
    50                                      
    51                                      ; Check if we already determined support
    52                                      mov        al, [movdir64b_supported]
    52 00000003 8A05(00000000)           ;;;  mov al, [movdir64b_supported]
    53                                      cmp        al, 0xff
    53 00000009 3CFF                     ;;;  cmp al, 0xff
    54                                      jne        .done
    54 0000000B 7534                     ;;;  jne .done
    55                                      
    56                                      ; First check if CPUID supports leaf 7
    57                                      mov        eax, 0
    57 0000000D B800000000               ;;;  mov eax, 0
    58                                      cpuid
    58 00000012 0FA2                     ;;;  cpuid
    59                                      cmp        eax, 7
    59 00000014 83F807                   ;;;  cmp eax, 7
    60                                      jl         .not_supported
    60 00000017 7C1F                     ;;;  jl .not_supported
    61                                      
    62                                      ; Check MOVDIR64B support (bit 28 in ECX from CPUID leaf 7, subleaf 0)
    63                                      mov        eax, 7
    63 00000019 B807000000               ;;;  mov eax, 7
    64                                      mov        ecx, 0
    64 0000001E B900000000               ;;;  mov ecx, 0
    65                                      cpuid
    65 00000023 0FA2                     ;;;  cpuid
    66                                      
    67                                      ; Test bit 28 in ECX
    68                                      test       ecx, (1 << 28)
    68 00000025 F7C100000010             ;;;  test ecx, (1 << 28)
    69                                      jz         .not_supported
    69 0000002B 740B                     ;;;  jz .not_supported
    70                                      
    71                                      ; MOVDIR64B is supported
    72                                      mov        byte [movdir64b_supported], 1
    72 0000002D C605(00000000)01         ;;;  mov byte [movdir64b_supported], 1
    73                                      mov        al, 1
    73 00000034 B001                     ;;;  mov al, 1
    74                                      jmp        .done
    74 00000036 EB09                     ;;;  jmp .done
    75                                      
    76                                  .not_supported:
    76                                   ;;; .not_supported:
    77                                      mov        byte [movdir64b_supported], 0
    77 00000038 C605(00000000)00         ;;;  mov byte [movdir64b_supported], 0
    78                                      mov        al, 0
    78 0000003F B000                     ;;;  mov al, 0
    79                                      
    80                                  .done:
    80                                   ;;; .done:
    81                                      pop        rdx
    81 00000041 5A                       ;;;  pop rdx
    82                                      pop        rcx
    82 00000042 59                       ;;;  pop rcx
    83                                      pop        rbx
    83 00000043 5B                       ;;;  pop rbx
    84                                      ret
    84 00000044 C3                       ;;;  ret
    85                                  
    86                                  ;-----------------------------------------------------------------------------
    87                                  ;-----------------------------------------------------------------------------
    88                                  ;  Procedure:	movdir64b_native
    89                                  ; 
    90                                  ;  Input:	Source (RSI)
    91                                  ;           Destination (RDI)
    92                                  ; 
    93                                  ;  Output:	None
    94                                  ; 
    95                                  ;  Description:  Native MOVDIR64B implementation
    96                                  ; 
    97                                  ;-----------------------------------------------------------------------------
    98                                  ;-----------------------------------------------------------------------------
    99                                  movdir64b_native:
    99                                   ;;; movdir64b_native:
   100                                      ; MOVDIR64B instruction using direct encoding
   101                                      DB 066h
   101 00000045 66                       ;;;  DB 066h
   102                                      DB 0Fh
   102 00000046 0F                       ;;;  DB 0Fh
   103                                      DB 038h
   103 00000047 38                       ;;;  DB 038h
   104                                      DB 0F8h
   104 00000048 F8                       ;;;  DB 0F8h
   105                                      DB 037h    ; ModRM = RDI->RSI
   105 00000049 37                       ;;;  DB 037h
   106                                      ret
   106 0000004A C3                       ;;;  ret
   107                                  
   108                                  ;-----------------------------------------------------------------------------
   109                                  ;-----------------------------------------------------------------------------
   110                                  ;  Procedure:	movdir64b_fallback
   111                                  ; 
   112                                  ;  Input:	Source (RSI)
   113                                  ;           Destination (RDI)
   114                                  ; 
   115                                  ;  Output:	None
   116                                  ; 
   117                                  ;  Description:  Fallback implementation using regular moves
   118                                  ; 
   119                                  ;-----------------------------------------------------------------------------
   120                                  ;-----------------------------------------------------------------------------
   121                                  movdir64b_fallback:
   121                                   ;;; movdir64b_fallback:
   122                                      push       rax
   122 0000004B 50                       ;;;  push rax
   123                                      
   124                                      ; Move 64 bytes using 8 x 8-byte moves
   125                                      mov        rax, [rsi]
   125 0000004C 488B06                   ;;;  mov rax, [rsi]
   126                                      mov        [rdi], rax
   126 0000004F 488907                   ;;;  mov [rdi], rax
   127                                      
   128                                      mov        rax, [rsi + 8]
   128 00000052 488B4608                 ;;;  mov rax, [rsi + 8]
   129                                      mov        [rdi + 8], rax
   129 00000056 48894708                 ;;;  mov [rdi + 8], rax
   130                                      
   131                                      mov        rax, [rsi + 16]
   131 0000005A 488B4610                 ;;;  mov rax, [rsi + 16]
   132                                      mov        [rdi + 16], rax
   132 0000005E 48894710                 ;;;  mov [rdi + 16], rax
   133                                      
   134                                      mov        rax, [rsi + 24]
   134 00000062 488B4618                 ;;;  mov rax, [rsi + 24]
   135                                      mov        [rdi + 24], rax
   135 00000066 48894718                 ;;;  mov [rdi + 24], rax
   136                                      
   137                                      mov        rax, [rsi + 32]
   137 0000006A 488B4620                 ;;;  mov rax, [rsi + 32]
   138                                      mov        [rdi + 32], rax
   138 0000006E 48894720                 ;;;  mov [rdi + 32], rax
   139                                      
   140                                      mov        rax, [rsi + 40]
   140 00000072 488B4628                 ;;;  mov rax, [rsi + 40]
   141                                      mov        [rdi + 40], rax
   141 00000076 48894728                 ;;;  mov [rdi + 40], rax
   142                                      
   143                                      mov        rax, [rsi + 48]
   143 0000007A 488B4630                 ;;;  mov rax, [rsi + 48]
   144                                      mov        [rdi + 48], rax
   144 0000007E 48894730                 ;;;  mov [rdi + 48], rax
   145                                      
   146                                      mov        rax, [rsi + 56]
   146 00000082 488B4638                 ;;;  mov rax, [rsi + 56]
   147                                      mov        [rdi + 56], rax
   147 00000086 48894738                 ;;;  mov [rdi + 56], rax
   148                                      
   149                                      pop        rax
   149 0000008A 58                       ;;;  pop rax
   150                                      ret
   150 0000008B C3                       ;;;  ret
   151                                  
   152                                  ;-----------------------------------------------------------------------------
   153                                  ;-----------------------------------------------------------------------------
   154                                  ;  Procedure:	Movdir64B
   155                                  ; 
   156                                  ;  Input:	Source (RCX)
   157                                  ;           Destination (RDX)
   158                                  ; 
   159                                  ;  Output:	None
   160                                  ; 
   161                                  ;  Description:  Wrapper that automatically chooses between native MOVDIR64B
   162                                  ;                and fallback implementation based on CPU support
   163                                  ; 
   164                                  ;-----------------------------------------------------------------------------
   165                                  ;-----------------------------------------------------------------------------
   166                                  global Movdir64B
   166                              <1>  ;;; [macro] global {Movdir64B}
     0                              <1> %rep %0
     0                              <1> [global %1]
     0                              <1> %rotate 1
     0                              <1> %endrep
     0                              <2> [global %1]
     0                              <2>  ;;; [global Movdir64B]
     0                              <2> %rotate 1
   167                                  Movdir64B :
   167                                   ;;; Movdir64B :
   168                                      push       rdi
   168 0000008C 57                       ;;;  push rdi
   169                                      push       rsi
   169 0000008D 56                       ;;;  push rsi
   170                                      
   171                                      mov        rsi, rcx    ; Source address
   171 0000008E 4889CE                   ;;;  mov rsi, rcx
   172                                      mov        rdi, rdx    ; Destination address
   172 00000091 4889D7                   ;;;  mov rdi, rdx
   173                                      
   174                                      ; Check if MOVDIR64B is supported
   175                                      call       check_movdir64b_support
   175 00000094 E867FFFFFF               ;;;  call check_movdir64b_support
   176                                      test       al, al
   176 00000099 84C0                     ;;;  test al, al
   177                                      jz         .use_fallback
   177 0000009B 7407                     ;;;  jz .use_fallback
   178                                      
   179                                      ; Use native MOVDIR64B
   180                                      call       movdir64b_native
   180 0000009D E8A3FFFFFF               ;;;  call movdir64b_native
   181                                      jmp        .done
   181 000000A2 EB05                     ;;;  jmp .done
   182                                      
   183                                  .use_fallback:
   183                                   ;;; .use_fallback:
   184                                      ; Use fallback implementation
   185                                      call       movdir64b_fallback
   185 000000A4 E8A2FFFFFF               ;;;  call movdir64b_fallback
   186                                      
   187                                  .done:
   187                                   ;;; .done:
   188                                      pop        rsi
   188 000000A9 5E                       ;;;  pop rsi
   189                                      pop        rdi
   189 000000AA 5F                       ;;;  pop rdi
   190                                      ret
   190 000000AB C3                       ;;;  ret

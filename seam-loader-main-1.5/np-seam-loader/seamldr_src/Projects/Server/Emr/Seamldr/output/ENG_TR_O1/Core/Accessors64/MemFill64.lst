   861                              <1>         loop    %$begin
   862                              <1> %$break:
   863                              <1>     %pop
   864                              <1> 
   865                              <1> %endmacro
   866                              <1> 
   867                              <1> 
   868                              <1> %macro BREAK_IF_EQUAL 2
   869                              <1> 	%ifctx REPEAT
   870                              <1>                 cmp %1,%2
   871                              <1>                 je %$break
   872                              <1> 	%else
   873                              <1> 		%fatal "BREAK_IF must be inside REPEAT"
   874                              <1> 	%endif
   875                              <1> %endmacro
   876                              <1> 
   877                              <1> %macro BREAK_IF_NOTEQUAL 2
   878                              <1> 	%ifctx REPEAT
   879                              <1>                 cmp %1,%2
   880                              <1>                 jne %$break
   881                              <1> 	%else
   882                              <1> 		%fatal "BREAK_IF must be inside REPEAT"
   883                              <1> 	%endif
   884                              <1> %endmacro
   885                              <1> 
   886                              <1> %macro BREAK_IF_ZERO 0
   887                              <1> 	%ifctx REPEAT
   888                              <1>                 je %$break
   889                              <1> 	%else
   890                              <1> 		%fatal "BREAK_IF must be inside REPEAT"
   891                              <1> 	%endif
   892                              <1> %endmacro
   893                              <1> 
   894                              <1> %macro BREAK_IF_NOT_ZERO 0
   895                              <1> 	%ifctx REPEAT
   896                              <1>                 jne %$break
   897                              <1> 	%else
   898                              <1> 		%fatal "BREAK_IF must be inside REPEAT"
   899                              <1> 	%endif
   900                              <1> %endmacro

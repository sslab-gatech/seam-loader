   218                              <1> %macro STACK_TEST_FILL_IN       0
   219                              <1> %if (MKF_ENGINEERING == 1)
   220                              <1>         mov     edi, stackStart
   221                              <1>         mov     ecx, esp
   222                              <1>         sub     ecx, stackStart
   223                              <1>         shr     ecx, 2
   224                              <1>         mov     eax, 0CCCCCCCCh
   225                              <1>         rep     stosd
   226                              <1> %endif
   227                              <1> %endmacro

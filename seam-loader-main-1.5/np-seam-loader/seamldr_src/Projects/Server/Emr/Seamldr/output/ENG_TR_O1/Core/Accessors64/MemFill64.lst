   133                              <1> %macro GETSEC_EXITAC 0
   134                              <1>         mov     eax, EXITAC                  ; GETSEC (EAX=3) for ExitAC
   135                              <1>         mov     ebx, %%RETURN_ADDRESS
   136                              <1>         xor     ecx, ecx
   137                              <1>         xor     edx, edx
   138                              <1>         _GETSEC
   139                              <1> %%RETURN_ADDRESS:
   140                              <1> %endmacro
   141                              <1> 
   142                              <1> %macro GETSEC_WAKEUP 0
   143                              <1>         mov     eax, WAKEUP                  ; GETSEC (EAX=8) for WAKEUP
   144                              <1>         xor     ebx, ebx
   145                              <1>         xor     ecx, ecx
   146                              <1>         xor     edx, edx
   147                              <1>         _GETSEC
   148                              <1> %endmacro
   149                              <1> 
   150                              <1> %macro GETSEC_SEXIT 0
   151                              <1>         mov     eax, SEXIT                  ; GETSEC (EAX=5) for SEXIT
   152                              <1>         xor     ebx, ebx
   153                              <1>         xor     ecx, ecx
   154                              <1>         xor     edx, edx
   155                              <1>         _GETSEC
   156                              <1> %endmacro

   208                              <1>         %if MKF_ENGINEERING eq 1
   209                              <1>                 %if MKF_TRACE EQ 1
   210                              <1>                         extern TraceTrampolineCodeError
   211                              <1>                         push DWORD %1
   212                              <1>                         call TraceTrampolineCodeError
   213                              <1> 
   214                              <1>                 %endif
   215                              <1>         %endif
   216                              <1> %endmacro

   194                              <1> %macro PROGRESS_MARK    1
   195                              <1>         push BYTE %1
   196                              <1>         call  ProgressMark
   197                              <1>         %if MKF_ENGINEERING eq 1
   198                              <1>                 %if MKF_TRACE EQ 1
   199                              <1>                         extern TraceProgress
   200                              <1>                         push DWORD %1
   201                              <1>                         call  TraceProgress
   202                              <1> 
   203                              <1>                 %endif
   204                              <1>         %endif
   205                              <1> %endmacro

   783                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   784                              <1> ;                       Helper macros
   785                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   786                              <1> 
   787                              <1> 
   788                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   789                              <1> ;            Implementation of if and else Macros
   790                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   791                              <1> 
   792                              <1> %macro IF 1
   793                              <1> 
   794                              <1>         %push IF
   795                              <1>         j%-1  %$ifnot
   796                              <1> 
   797                              <1> %endmacro
   798                              <1> 
   799                              <1> %macro ELSE 0
   800                              <1> 
   801                              <1>   %ifctx IF
   802                              <1>         %repl   else
   803                              <1>         jmp     %$ifend
   804                              <1>         %$ifnot:
   805                              <1>   %else
   806                              <1>         %error  "expected IF before ELSE"
   807                              <1>   %endif
   808                              <1> 
   809                              <1> %endmacro
   810                              <1> 
   811                              <1> %macro ENDIF 0
   812                              <1> 
   813                              <1>   %ifctx IF
   814                              <1>         %$ifnot:
   815                              <1>         %pop
   816                              <1>   %elifctx  else
   817                              <1>         %$ifend:
   818                              <1>         %pop
   819                              <1>   %else
   820                              <1>         %error  "expected IF or ELSE before ENDIF"
   821                              <1>   %endif
   822                              <1> 
   823                              <1> %endmacro
   824                              <1> 
   825                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   826                              <1> ;  Implementation of Repeat Macro
   827                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   828                              <1> 
   829                              <1> %macro REPEAT 0
   830                              <1> 
   831                              <1>     %push   REPEAT
   832                              <1>     %$begin:
   833                              <1> 
   834                              <1> %endmacro
   835                              <1> 
   836                              <1> %macro UNTIL_FOREVER 0
   837                              <1>         jmp    %$begin
   838                              <1> %$break:
   839                              <1>     %pop
   840                              <1> 
   841                              <1> %endmacro
   842                              <1> 

   158                              <1> %macro TDATA_VAR  0
   159                              <1>         ;
   160                              <1>         ; Changing hardcoded T_DATA onto one retrieved from SINIT size
   161                              <1>         ;
   162                              <1>         mov     edi, LT_PUB_BASE + TXT.LT_SINIT_SIZE
   163                              <1>         mov     edi, DWORD [edi]    ; Get SINIT region size
   164                              <1>         add     edi, ebp
   165                              <1>         sub     edi, _64KB
   166                              <1> %endmacro
   167                              <1> %define TDATA_VAR_RET_VAL(x)  [edi + x] ; Sighting #3865476  End
   167                              <1>  ;;; %define TDATA_VAR_RET_VAL(x) [edi + x]
   168                              <1> 
   169                              <1> %macro TDATA_VAR_OFFSET_IN_EAX        1
   170                              <1>         ;
   171                              <1>         ; ebp keeps address of SINIT module in memory
   172                              <1>         ;
   173                              <1>         ; Changing hardcoded T_DATA onto one retrieved from SINIT size
   174                              <1>         ;
   175                              <1>         mov     edi, LT_PUB_BASE + TXT.LT_SINIT_SIZE
   176                              <1>         mov     eax, DWORD [edi]    ; Get SINIT region size
   177                              <1>         sub     eax, _64KB
   178                              <1>         add     eax, ebp
   179                              <1>         add     eax, %1
   180                              <1> 
   181                              <1> %endmacro
   182                              <1> 
   183                              <1> %define EDATA_VAR(x)    [ebp +  x]
   183                              <1>  ;;; %define EDATA_VAR(x) [ebp + x]
   184                              <1> 
   185                              <1> 
   186                              <1> %macro EDATA_VAR_OFFSET_IN_EAX        1
   187                              <1>         ;;
   188                              <1>         ;; ebp keeps address of SINIT module in memory
   189                              <1>         ;;
   190                              <1>         mov     eax, ebp
   191                              <1>         add     eax, %1
   192                              <1> %endmacro
